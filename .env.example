# ===========================================================================
# 环境变量模板
#
# 用法（重要：项目代码实际加载的是 customer_service/.env，不是根目录 .env）：
#     cp .env.example customer_service/.env      # Windows: Copy-Item .env.example customer_service\.env
# 然后填入你自己的 Key。customer_service/.env 已被 .gitignore 忽略，不会入库。
# ===========================================================================

# --- LLM 网关（DashScope / 百炼兼容模式）：代码读的唯一 LLM 凭据 -------------
# 必需。没有它 main.py / langgraph dev 一调模型就 401。
# 朋友用自己的 Key（百炼有免费额度），别共享白哥的。
DASHSCOPE_API_KEY=sk-xxxxxxxx
# 模型可换：qwen-plus / qwen3.6-plus / MiniMax-M2.1 / deepseek-v3.2 等兼容模式支持的都行
MODEL_NAME=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- RAG 嵌入模型（P1）-----------------------------------------------------
# 维度必须与代码一致：rag/ingest.py 的 DocIngestionPipeline.EMBED_DIM = 1024
EMBEDDING_MODEL=text-embedding-v4

# --- 存储（唯一 DSN：代码只认 DATABASE_URL）--------------------------------
# customer_service/db.py、memory/checkpointer.py、rag/ingest.py、rag/retriever.py
# 全部读这一个变量；db/apply_schema.py 也是。改连接只改这一行。
#
# 端口 5433 是宿主机映射端口（容器内仍是 5432），故意避开常见的 5432 冲突。
# 库名 pg4mysql 是历史遗留（早期多实例合并而来），不是笔误，别改。
#
# 注意：这不是普通 PG，是 ParadeDB 镜像，自带 pg_search(BM25) + pgvector。
# 前置：先 `docker compose up -d` 把库起来，再跑 db/apply_schema.py 建业务表。
DATABASE_URL="postgresql://postgres:pgpass@localhost:5433/pg4mysql"

# --- docker-compose 变量（只给 compose 用，代码不读）-----------------------
# 改这里能同步改容器账号/库名/端口；改了账号密码库名就要同步改上面的 DATABASE_URL。
PG_USER=postgres
PG_PASSWORD=pgpass
PG_DATABASE=pg4mysql
PG_PORT=5433
REDIS_PORT=6379

# --- Redis（P8 计划：会话缓存 / 限流 / 任务队列）----------------------------
# 现状：代码里还没有任何 redis 引用，容器已由 docker-compose 备好。
# P8 接线时再在代码里读这个变量，当前留着不生效。
REDIS_URL=redis://localhost:6379/0

# --- OTel + Langfuse（评测 E1，先起 docker-compose.observability.yml）-------
# 应用发 trace 到本地 OTel Collector，由它转发进 Langfuse；key 与 compose 里
# LANGFUSE_INIT_PROJECT_* 那对保持一致。控制台 http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=pk-lf-tcs-dev-0001
LANGFUSE_SECRET_KEY=sk-lf-tcs-dev-0001
LANGFUSE_HOST=http://localhost:3000

# --- 可观测性（可选）-------------------------------------------------------
# 不开追踪就留空：customer_service/__init__.py 会把 LANGCHAIN_TRACING_V2 置 false
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=text-customer-service

# --- 其他可选（骨架阶段可能用到）-------------------------------------------
# 外部联网检索工具用；不用就留空
TAVILY_API_KEY=
